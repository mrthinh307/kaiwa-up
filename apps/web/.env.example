# Server-only backend URL. Required in Vercel production.
API_BASE_URL=http://localhost:8000

# Optional browser override for local development. Leave unset in production so
# the browser uses same-origin /api requests through the Next.js rewrite.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public Cloudinary cloud name used by Next Image allowlisting in deployments.
CLOUDINARY_CLOUD_NAME=
