APP_NAME="Kaiwa App API"
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]

# Database configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
DATABASE_URL_TEST=postgresql+asyncpg://user:password@your-test-neon-db-host/dbname?ssl=require
# Use a direct (non-pooled) connection for Alembic in production.
MIGRATION_DATABASE_URL=
RELEASE_SHA=local

# Auth configuration
JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Set to true in production
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# Background jobs (disable when using free multi-instance or sleeping hosting)
LEADERBOARD_REBUILD_ENABLED=true
LEADERBOARD_REBUILD_INTERVAL_HOURS=1

# Cloudinary configuration
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=kaiwa-up

# Required only when running the full demo seed script. Never commit its real value.
DEMO_SEED_PASSWORD=

# --- AI Gateway (routing theo chức năng: tutor / evaluate / stt) ---
# Mỗi lane = primary provider + fallback list (csv, theo tên đăng ký bên dưới).
# Dùng "fake" khi chưa có key để chạy dev mà không cần gọi provider thật.
AI_TUTOR_PROVIDER=fake
AI_TUTOR_FALLBACK_PROVIDERS=
AI_EVAL_PROVIDER=fake
AI_EVAL_FALLBACK_PROVIDERS=
AI_STT_PROVIDER=fake
AI_STT_FALLBACK_PROVIDERS=
AI_LLM_MODEL=
AI_STT_MODEL=
AI_TEMPERATURE=0.2
AI_TOP_P=1.0
AI_MAX_OUTPUT_TOKENS=1000
AI_TIMEOUT_SECONDS=30
# Optional per-capability timeouts (seconds); leave commented to use AI_TIMEOUT_SECONDS
# AI_STT_TIMEOUT_SECONDS=
# AI_REFLEX_TIMEOUT_SECONDS=
# AI_SHADOWING_TIMEOUT_SECONDS=
# AI_TRANSLATION_TIMEOUT_SECONDS=
# AI_TUTOR_TIMEOUT_SECONDS=
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=0.5
AI_MAX_RETRY_BACKOFF_SECONDS=8

# --- OpenAI (openai-compatible) ---
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_LLM_MODEL=gpt-4o-mini
AI_OPENAI_STT_MODEL=whisper-1

# --- Groq
AI_GROQ_API_KEY=
AI_GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_GROQ_LLM_MODEL=llama-3.3-70b-versatile
AI_GROQ_STT_MODEL=whisper-large-v3
