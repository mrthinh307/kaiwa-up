{
  "openapi": "3.1.0",
  "info": {
    "title": "Kaiwa App API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Check application health",
        "operationId": "health_check_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ready": {
      "get": {
        "tags": ["Health"],
        "summary": "Check application and database readiness",
        "operationId": "readiness_check_api_v1_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database is not ready"
          }
        }
      }
    },
    "/api/v1/progress/summary": {
      "get": {
        "tags": ["Progress"],
        "summary": "Get progress summary for the current user",
        "operationId": "get_progress_summary_api_v1_progress_summary_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProgressSummaryResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/progress/attempts": {
      "get": {
        "tags": ["Progress"],
        "summary": "List attempt history for the current user",
        "operationId": "list_progress_attempts_api_v1_progress_attempts_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "content_type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ContentType"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Content Type"
            }
          },
          {
            "name": "content_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Content Id"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Page Size"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedResponse_ProgressAttemptItem_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/progress/attempts/{attempt_id}": {
      "get": {
        "tags": ["Progress"],
        "summary": "Get a single attempt detail for the current user",
        "operationId": "get_progress_attempt_api_v1_progress_attempts__attempt_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "attempt_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Attempt Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProgressAttemptDetail"
                }
              }
            }
          },
          "403": {
            "description": "Attempt belongs to another user"
          },
          "404": {
            "description": "Attempt not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/gamification/profile": {
      "get": {
        "tags": ["Gamification"],
        "summary": "Get the current user's EXP, level, and recent EXP history",
        "operationId": "get_gamification_profile_api_v1_gamification_profile_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GamificationProfileResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/register": {
      "post": {
        "summary": "Register",
        "description": "Register a new user.",
        "operationId": "register_api_v1_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/login": {
      "post": {
        "summary": "Login",
        "description": "Authenticate with email/password.",
        "operationId": "login_api_v1_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/refresh": {
      "post": {
        "summary": "Refresh",
        "description": "Rotate the refresh token and issue a new access token.",
        "operationId": "refresh_api_v1_refresh_post",
        "parameters": [
          {
            "name": "refresh_token",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Refresh Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/logout": {
      "post": {
        "summary": "Logout",
        "description": "Revoke the current refresh token and clear its cookie.",
        "operationId": "logout_api_v1_logout_post",
        "parameters": [
          {
            "name": "refresh_token",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Refresh Token"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "summary": "Get Me",
        "description": "Return the authenticated user's profile.",
        "operationId": "get_me_api_v1_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "patch": {
        "summary": "Update Me",
        "description": "Update the authenticated user's display name.",
        "operationId": "update_me_api_v1_me_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AccessTokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          }
        },
        "type": "object",
        "required": ["access_token", "expires_in"],
        "title": "AccessTokenResponse",
        "description": "Access token response returned by login and refresh."
      },
      "AttemptStatus": {
        "type": "string",
        "enum": ["in_progress", "submitted", "completed"],
        "title": "AttemptStatus"
      },
      "ContentType": {
        "type": "string",
        "enum": ["shadowing", "dictation", "reflex", "listening_translation"],
        "title": "ContentType"
      },
      "ExpHistoryItem": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "attempt_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attempt Id"
          },
          "amount": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Amount"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": ["id", "amount", "created_at"],
        "title": "ExpHistoryItem"
      },
      "GamificationProfileResponse": {
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Level"
          },
          "level_title": {
            "type": "string",
            "title": "Level Title"
          },
          "total_exp": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Exp"
          },
          "current_level_min_exp": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Current Level Min Exp"
          },
          "next_level_min_exp": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Level Min Exp"
          },
          "exp_to_next_level": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Exp To Next Level"
          },
          "recent_exp_history": {
            "items": {
              "$ref": "#/components/schemas/ExpHistoryItem"
            },
            "type": "array",
            "title": "Recent Exp History"
          }
        },
        "type": "object",
        "required": [
          "level",
          "level_title",
          "total_exp",
          "current_level_min_exp",
          "exp_to_next_level"
        ],
        "title": "GamificationProfileResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "app_name": {
            "type": "string",
            "title": "App Name"
          }
        },
        "type": "object",
        "required": ["status", "timestamp", "app_name"],
        "title": "HealthResponse"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["email", "password"],
        "title": "LoginRequest",
        "description": "Payload for email/password login."
      },
      "PaginatedResponse_ProgressAttemptItem_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProgressAttemptItem"
            },
            "type": "array",
            "title": "Items"
          },
          "total_items": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Items"
          },
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page Size"
          },
          "total_pages": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Pages"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total_items",
          "page",
          "page_size",
          "total_pages"
        ],
        "title": "PaginatedResponse[ProgressAttemptItem]"
      },
      "ProgressAttemptDetail": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "content_id": {
            "type": "string",
            "format": "uuid",
            "title": "Content Id"
          },
          "content_type": {
            "$ref": "#/components/schemas/ContentType"
          },
          "attempt_number": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Attempt Number"
          },
          "status": {
            "$ref": "#/components/schemas/AttemptStatus"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "answer_payload": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer Payload"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "content_id",
          "content_type",
          "attempt_number",
          "status"
        ],
        "title": "ProgressAttemptDetail"
      },
      "ProgressAttemptItem": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "content_id": {
            "type": "string",
            "format": "uuid",
            "title": "Content Id"
          },
          "content_title": {
            "type": "string",
            "title": "Content Title"
          },
          "content_type": {
            "$ref": "#/components/schemas/ContentType"
          },
          "attempt_number": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Attempt Number"
          },
          "status": {
            "$ref": "#/components/schemas/AttemptStatus"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "content_id",
          "content_title",
          "content_type",
          "attempt_number",
          "status"
        ],
        "title": "ProgressAttemptItem"
      },
      "ProgressSummaryResponse": {
        "properties": {
          "shadowing_completed": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Shadowing Completed"
          },
          "dictation_completed": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Dictation Completed"
          },
          "reflex_completed": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Reflex Completed"
          },
          "listening_translation_completed": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Listening Translation Completed"
          },
          "total_completed_attempts": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Completed Attempts"
          },
          "total_attempts": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Attempts"
          }
        },
        "type": "object",
        "required": [
          "shadowing_completed",
          "dictation_completed",
          "reflex_completed",
          "listening_translation_completed",
          "total_completed_attempts",
          "total_attempts"
        ],
        "title": "ProgressSummaryResponse"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ready",
            "title": "Status"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "app_name": {
            "type": "string",
            "title": "App Name"
          },
          "database": {
            "type": "string",
            "const": "ok",
            "title": "Database"
          }
        },
        "type": "object",
        "required": ["status", "timestamp", "app_name", "database"],
        "title": "ReadinessResponse"
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          },
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["email", "password", "name"],
        "title": "RegisterRequest",
        "description": "Payload for registering a new user."
      },
      "UserResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "avatar_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar Url"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "display_name",
          "avatar_url",
          "role",
          "is_active"
        ],
        "title": "UserResponse",
        "description": "Public representation of a user."
      },
      "UserRole": {
        "type": "string",
        "enum": ["user", "admin"],
        "title": "UserRole"
      },
      "UserUpdateRequest": {
        "properties": {
          "display_name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Display Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["display_name"],
        "title": "UserUpdateRequest",
        "description": "Allowed fields for updating the current user's profile."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
