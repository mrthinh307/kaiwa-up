# Root-level variables used by Docker Compose will be documented here.
COMPOSE_PROJECT_NAME=kaiwa-app
# Database connection strings for the application and tests.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/appdb
DATABASE_URL_TEST=postgresql+asyncpg://user:password@ep-xxxx-test.region.aws.neon.tech/dbname?ssl=require
